---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import OrdenServicio from '@/components/OrdenServicio.astro';
import { site, dayLabels, dayOrder, formatTime, fullAddress, mapEmbedUrl, mapLinkUrl, whatsappUrl } from '@/config/site';
import { businessSchema } from '@/lib/schema';
import elevador from '@/assets/fotos/elevador.jpg';
---

<BaseLayout
  title="Contacto y cómo llegar"
  description={`Taller mecánico en ${site.address.neighborhood}, ${site.address.city}. Dirección, horario, estacionamiento, grúa y orden de servicio por WhatsApp.`}
  folio="0005"
  jsonLd={(og) => [businessSchema(og)]}
>
  <section class="cabeza contenedor" aria-labelledby="titulo">
    <p class="etiqueta">Hoja 7 · Mostrador</p>
    <h1 id="titulo" class="titulo">Aquí estamos</h1>
    <p class="dir">{fullAddress}</p>
  </section>

  <div class="contenedor indicaciones">
    <section class="hoja como" aria-labelledby="como-titulo">
      <span class="cinta" style="--r:-4deg; left:40%; top:-0.9rem"></span>
      <h2 id="como-titulo" class="rotulo sub">Cómo llegar</h2>
      <ol class="pasos">
        <li><span class="datos n">1</span><p>{site.address.reference}</p></li>
        <li><span class="datos n">2</span><p><strong>Estacionamiento.</strong> {site.address.parking}</p></li>
        <li><span class="datos n">3</span><p><strong>Si lo dejas.</strong> {site.address.transit}</p></li>
      </ol>
      <a class="btn btn--papel" href={mapLinkUrl} target="_blank" rel="noopener">Abrir en mapas</a>
    </section>

    <section class="grua sello sello--tinta" style="--r:3deg" aria-labelledby="grua-titulo">
      <h2 id="grua-titulo" class="grua-t">{site.grua.label}</h2>
      <p class="datos grua-d">{site.grua.detail}</p>
      <a class="datos subrayado" href={whatsappUrl('Hola, necesito la grúa. Estoy en: ')} target="_blank" rel="noopener">Pedir grúa por WhatsApp →</a>
    </section>

    <section class="datos-contacto" aria-labelledby="horario-titulo">
      <h2 id="horario-titulo" class="etiqueta">Horario de mostrador</h2>
      <table class="datos">
        <tbody>
          {
            dayOrder.map((d) => (
              <tr>
                <th scope="row">{dayLabels[d]}</th>
                <td>{site.hours[d].length ? site.hours[d].map((s) => `${formatTime(s.open)} – ${formatTime(s.close)}`).join(', ') : 'Cerrado'}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <ul class="medios datos">
        <li><a class="subrayado" href={`tel:${site.contact.phone}`}>Tel. {site.contact.phoneDisplay}</a></li>
        <li><a class="subrayado" href={whatsappUrl('Hola, les escribo desde su página.')} target="_blank" rel="noopener">WhatsApp {site.contact.phoneDisplay}</a></li>
        <li><a class="subrayado" href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
      </ul>
      <p class="pago">{site.payments}</p>
    </section>

    <figure class="foto">
      <div class="foto-duo" style="clip-path: polygon(0 2%, 98% 0, 100% 97%, 3% 100%)">
        <span class="respaldo">Foto: la bahía del taller</span>
        <Image src={elevador} alt="Auto con el cofre abierto sobre un elevador hidráulico en la bahía de un taller" widths={[400, 700, 900]} sizes="(min-width: 64rem) 40vw, 92vw" loading="lazy" format="webp" quality={60} onerror="this.parentElement.classList.add('sin-foto')" />
      </div>
      <figcaption class="datos">La bahía 2. Caben dos autos en elevador y cuatro en piso.</figcaption>
    </figure>

    <figure class="mapa">
      <iframe src={mapEmbedUrl} title={`Mapa: ${site.name}, ${fullAddress}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" width="600" height="360"></iframe>
    </figure>
  </div>

  <OrdenServicio titulo="Orden de servicio" />
</BaseLayout>

<style>
  .cabeza {
    padding-block: clamp(1.5rem, 4vw, 3rem) 2rem;
  }

  .cabeza .etiqueta {
    color: var(--oxido-oscuro);
  }

  .titulo {
    font-size: var(--text-rotulo-xl);
    margin-top: 0.3rem;
  }

  .dir {
    margin-top: 1rem;
    font-family: var(--font-datos);
    font-weight: 700;
    font-size: clamp(1rem, 0.9rem + 0.6vw, 1.35rem);
    max-width: 34rem;
  }

  .indicaciones {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 2rem;
  }

  .como {
    padding: 1.6rem clamp(1.1rem, 3vw, 2rem);
    rotate: -0.6deg;
  }

  .sub {
    font-size: var(--text-rotulo-s);
    margin-bottom: 1rem;
  }

  .pasos {
    list-style: none;
    margin: 0 0 1.4rem;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .pasos li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.6rem;
  }

  .n {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    background: var(--grasa);
    color: var(--mostaza);
    font-weight: 700;
  }

  .grua {
    justify-self: start;
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    text-align: left;
    padding: 1rem 1.2rem;
    max-width: 22rem;
    mask-image: none;
    -webkit-mask-image: none;
    border-width: 4px;
    background: var(--mostaza);
  }

  .grua-t {
    font-size: var(--text-rotulo-s);
  }

  .grua-d {
    font-size: var(--text-mono-s);
    text-transform: none;
    font-family: var(--font-datos);
    font-weight: 400;
    line-height: 1.4;
  }

  .grua a {
    font-size: var(--text-mono-s);
    text-transform: none;
    font-weight: 700;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    text-decoration-color: var(--grasa);
  }

  .datos-contacto .etiqueta {
    color: var(--acero-oscuro);
    margin-bottom: 0.6rem;
  }

  table {
    width: 100%;
    max-width: 26rem;
    border-collapse: collapse;
    font-size: var(--text-mono-s);
  }

  th,
  td {
    text-align: left;
    padding: 0.3rem 0;
    border-bottom: 1.5px dashed rgb(20 18 15 / 0.4);
  }

  th {
    font-weight: 400;
    width: 7.5rem;
  }

  .medios {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
    font-size: var(--text-mono-s);
  }

  .medios a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .pago {
    margin-top: 0.8rem;
    font-size: 0.92rem;
    max-width: 26rem;
  }

  .foto {
    margin: 0;
  }

  .foto .foto-duo {
    aspect-ratio: 4 / 3;
  }

  .foto figcaption {
    margin-top: 0.4rem;
    font-size: var(--text-mono-xs);
    color: var(--acero-oscuro);
  }

  .mapa {
    margin: 0;
    padding: 0.6rem;
    background: var(--papel);
    border: var(--borde);
    box-shadow: var(--shadow-2);
    rotate: 0.8deg;
  }

  .mapa iframe {
    display: block;
    width: 100%;
    height: 20rem;
    border: var(--borde);
    filter: grayscale(1) sepia(0.35) contrast(1.05);
  }

  @media (min-width: 64rem) {
    .indicaciones {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 2.5rem 2rem;
      align-items: start;
    }

    .como {
      grid-column: 1 / span 6;
    }

    .grua {
      grid-column: 8 / span 4;
      margin-top: 2rem;
    }

    .datos-contacto {
      grid-column: 8 / span 5;
      grid-row: 2;
      margin-top: -3rem;
    }

    .foto {
      grid-column: 1 / span 5;
      grid-row: 2 / span 2;
      margin-left: 6%;
    }

    .mapa {
      grid-column: 6 / span 7;
      grid-row: 3;
    }
  }
</style>

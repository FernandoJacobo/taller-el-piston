---
/** Barra inferior fija en móvil: dos rótulos, Llamar y WhatsApp. */
import { site, whatsappUrl } from '@/config/site';
---

<nav class="barra-movil" aria-label="Contacto rápido">
  <a href={`tel:${site.contact.phone}`} class="llamar">
    <span class="rotulo">Llamar</span>
    <span class="datos">{site.contact.phoneDisplay}</span>
  </a>
  <a href={whatsappUrl('Hola, quiero agendar una revisión.')} class="wa" rel="noopener" target="_blank">
    <span class="rotulo">WhatsApp</span>
    <span class="datos">Contesta el mostrador</span>
  </a>
</nav>

<style>
  .barra-movil {
    position: fixed;
    inset: auto 0 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    border-top: var(--borde);
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--grasa);
  }

  a {
    display: grid;
    align-content: center;
    min-height: 4.4rem;
    padding: 0.35rem 1rem;
    text-decoration: none;
    line-height: 1;
  }

  a:active .rotulo {
    translate: 1px 2px;
  }

  .rotulo {
    font-size: 1.7rem;
    letter-spacing: 0.02em;
  }

  .datos {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    margin-top: 0.2rem;
    text-transform: uppercase;
  }

  .llamar {
    background: var(--oxido-oscuro);
    color: var(--papel);
    border-right: var(--borde);
  }

  .wa {
    background: var(--mostaza);
    color: var(--grasa);
  }

  @media (min-width: 64rem) {
    .barra-movil {
      display: none;
    }
  }

  @media print {
    .barra-movil {
      display: none;
    }
  }
</style>

---
/**
 * Odómetro mecánico: cada dígito es un rodillo 0–9 que gira por su cuenta (las unidades
 * dan más vueltas y tardan más, como en el tablero). El HTML ya trae el número final:
 * sin JS o con prefers-reduced-motion se ve quieto y correcto.
 */
interface Props {
  valor: number;
  digitos?: number;
  etiqueta: string;
}
const { valor, digitos = 6, etiqueta } = Astro.props;
const cifras = String(valor).padStart(digitos, '0').split('').map(Number);
const tira = Array.from({ length: 30 }, (_, i) => i % 10);
---

<div class="odometro" data-odometro role="img" aria-label={`${valor.toLocaleString('es-MX')} ${etiqueta}`}>
  <div class="ventana" aria-hidden="true">
    {
      cifras.map((d, i) => {
        // Vueltas extra: el rodillo de la derecha gira más
        const vueltas = i === cifras.length - 1 ? 2 : i >= cifras.length - 3 ? 1 : 0;
        return (
          <span class:list={['rodillo', { ultimo: i === cifras.length - 1 }]} style={`--pos:${d + vueltas * 10}; --i:${i}`}>
            <span class="tira">
              {tira.map((n) => (
                <span>{n}</span>
              ))}
            </span>
          </span>
        );
      })
    }
  </div>
</div>

<script>
  const odos = document.querySelectorAll<HTMLElement>('[data-odometro]');
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    odos.forEach((o) => o.classList.add('en-cero'));
    const io = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (!e.isIntersecting) continue;
          // Un cuadro en cero y luego a girar
          requestAnimationFrame(() => e.target.classList.replace('en-cero', 'girando'));
          io.unobserve(e.target);
        }
      },
      { threshold: 0.6 },
    );
    odos.forEach((o) => io.observe(o));
  }
</script>

<style>
  .odometro {
    display: inline-block;
  }

  .ventana {
    display: inline-flex;
    gap: 3px;
    padding: 6px;
    background: #0a0908;
    border: 3px solid var(--acero);
    box-shadow:
      inset 0 0 0 2px #000,
      5px 5px 0 rgb(0 0 0 / 0.5);
  }

  .rodillo {
    position: relative;
    display: block;
    width: 0.66em;
    height: 1.1em;
    overflow: hidden;
    background: #f1ece0;
    color: var(--grasa);
    font-family: var(--font-datos);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.1em;
    text-align: center;
  }

  /* Sombra de cilindro: el rodillo se ve curvo (es un gris, no un gradiente de color) */
  .rodillo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(rgb(0 0 0 / 0.5), transparent 32%, transparent 68%, rgb(0 0 0 / 0.5));
    pointer-events: none;
  }

  .rodillo.ultimo {
    background: var(--oxido);
    color: var(--papel);
  }

  .tira {
    display: grid;
    translate: 0 calc(var(--pos) * -1.1em);
  }

  .en-cero .tira {
    translate: 0 0;
  }

  .girando .tira {
    transition: translate calc(1.1s + var(--i) * 0.28s) cubic-bezier(0.2, 0.7, 0.25, 1.04);
    transition-delay: calc(var(--i) * 0.06s);
  }
</style>

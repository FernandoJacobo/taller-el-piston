---
/** Sello redondo "REVISIÓN SIN COSTO" que gira lento (se detiene con prefers-reduced-motion). */
interface Props {
  class?: string;
}
const { class: clase = '' } = Astro.props;
const id = `aro-${Math.random().toString(36).slice(2, 7)}`;
---

<div class:list={['sello-giro', clase]} role="img" aria-label="Sello: revisión sin costo si se repara aquí">
  <svg viewBox="0 0 200 200" aria-hidden="true">
    <defs>
      <path id={id} d="M100 100 m-74 0 a74 74 0 1 1 148 0 a74 74 0 1 1 -148 0"></path>
    </defs>
    <g class="aro">
      <circle cx="100" cy="100" r="96" fill="none" stroke="currentColor" stroke-width="5"></circle>
      <circle cx="100" cy="100" r="56" fill="none" stroke="currentColor" stroke-width="3"></circle>
      <text>
        <textPath href={`#${id}`} textLength="462">REVISIÓN SIN COSTO ✕ SI SE REPARA AQUÍ ✕</textPath>
      </text>
    </g>
    <text x="100" y="114" text-anchor="middle" class="centro">$0</text>
  </svg>
</div>

<style>
  .sello-giro {
    color: var(--oxido);
    aspect-ratio: 1;
    rotate: -12deg;
    mask-image: var(--tinta-gastada);
    mask-size: 160px;
    -webkit-mask-image: var(--tinta-gastada);
    -webkit-mask-size: 160px;
  }

  svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  text {
    fill: currentColor;
    font-family: var(--font-rotulo);
    font-weight: 900;
    font-size: 25px;
    letter-spacing: 1px;
  }

  .centro {
    font-size: 50px;
  }

  .aro {
    transform-origin: 100px 100px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .aro {
      animation: girar 40s linear infinite;
    }
  }

  @keyframes girar {
    to {
      rotate: 360deg;
    }
  }
</style>

---
/**
 * F · Sellos dispersos sobre una hoja. Seis sellos de goma de formas distintas,
 * cada uno con su rotación; se estampan al entrar en vista (scripts/estampa.ts).
 */
import { site } from '@/config/site';
import { compromisos } from '@/data/compromisos';
---

<section class="firmamos" aria-labelledby="firmamos-titulo">
  <div class="contenedor">
    <div class="hoja sabana rasgado">
      <p class="etiqueta encabezado-hoja">
        <span>Hoja 4 · Condiciones del servicio</span>
        <span class="datos">Válidas en toda orden con folio</span>
      </p>

      <ul class="sellos">
        {
          compromisos.map((c, i) => (
            <li class:list={['item', `item--${i + 1}`]}>
              <div class:list={['sello', `sello--${c.forma}`, { 'sello--oscuro': i % 2 === 1 }]} style={`--r:${c.r}deg; --delay:${i * 0.12}s`} data-estampa>
                {c.forma === 'fechador' && <span class="fecha datos">{new Date().getFullYear()} · REG.</span>}
                <span class="grande">{c.sello}</span>
                <span class="chico datos">{c.sub}</span>
              </div>
              <p class="detalle">{c.detalle}</p>
            </li>
          ))
        }
      </ul>

      <div class="cierre">
        <h2 id="firmamos-titulo" class="titulo">Lo que<br />firmamos</h2>
        <div class="firma-taller">
          <svg viewBox="0 0 200 50" aria-hidden="true">
            <path d="M6 38 C20 6 30 4 28 30 C26 46 44 14 52 18 C60 22 50 40 62 34 L76 20 C82 14 84 34 94 30 C110 22 118 12 124 26 C128 36 140 30 150 24 C162 18 176 28 194 14" fill="none" stroke="var(--grasa)" stroke-width="2.6" stroke-linecap="round"></path>
          </svg>
          <p class="datos">{site.name} · R. Rangel, encargado</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .firmamos {
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(2.5rem, 5vw, 4rem);
  }

  .sabana {
    padding: clamp(1.2rem, 3vw, 2.4rem) clamp(1.1rem, 4vw, 3.5rem) clamp(3rem, 6vw, 5rem);
    box-shadow: none;
    border-bottom: 0;
    rotate: -0.4deg;
    margin-left: clamp(0rem, 3vw, 3rem);
  }

  .encabezado-hoja {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    padding-bottom: 0.6rem;
    border-bottom: var(--borde);
    color: var(--acero);
  }

  .sellos {
    list-style: none;
    margin: 2.4rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.6rem 1.2rem;
  }

  .item {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.8rem;
    text-align: center;
  }

  .item:nth-child(odd) {
    translate: 0 0.8rem;
  }

  .detalle {
    font-size: 0.9rem;
    line-height: 1.4;
    max-width: 17rem;
  }

  /* ─── Formas de sello ─── */
  .sello {
    gap: 0.25rem;
    min-width: 9rem;
  }

  .grande {
    font-size: clamp(1.45rem, 1.1rem + 1.4vw, 2.3rem);
    line-height: 0.88;
  }

  .chico {
    color: var(--oxido-oscuro);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .sello--redondo {
    width: 9.5rem;
    min-width: 0;
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    border-width: 4px;
    box-shadow: inset 0 0 0 5px var(--papel), inset 0 0 0 7px var(--c);
    padding: 1.2rem;
  }

  .sello--redondo .chico {
    line-height: 1.25;
    max-width: 6.5rem;
    text-align: center;
  }

  .sello--doble {
    padding: 0.7rem 1rem;
  }

  .sello--ovalo {
    border-radius: 50%;
    padding: 1.2rem 1.8rem;
    border-width: 3px;
  }

  .sello--fechador {
    padding: 0.4rem 1rem 0.6rem;
    border-width: 3px 3px 7px;
  }

  .sello--fechador .fecha {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    border-bottom: 2px solid var(--c);
    width: 100%;
    padding-bottom: 0.15rem;
  }

  .sello--roto {
    border-style: dashed;
    border-width: 4px;
    padding: 0.8rem 1.2rem;
  }

  .sello--roto .grande {
    font-size: clamp(2rem, 1.4rem + 2vw, 3.2rem);
  }

  .sello--esquina {
    padding: 0.6rem 1rem 0.6rem 1.6rem;
    border-left-width: 12px;
  }

  .cierre {
    display: grid;
    gap: 1.5rem;
    justify-items: end;
    margin-top: 3.5rem;
    text-align: right;
  }

  .titulo {
    font-size: var(--text-rotulo-l);
  }

  .firma-taller {
    width: min(100%, 17rem);
  }

  .firma-taller svg {
    width: 100%;
    border-bottom: var(--borde);
  }

  .firma-taller p {
    font-size: var(--text-mono-xs);
    color: var(--acero);
    margin-top: 0.2rem;
  }

  @media (min-width: 48rem) {
    .sellos {
      grid-template-columns: repeat(3, 1fr);
    }

    .item:nth-child(odd) {
      translate: none;
    }

    .item--2 {
      translate: 0 2.8rem;
    }

    .item--4 {
      translate: 1.5rem -0.6rem;
    }

    .item--6 {
      translate: -1rem 1.8rem;
    }
  }

  @media (min-width: 64rem) {
    .sellos {
      grid-template-columns: repeat(12, 1fr);
      grid-template-rows: auto auto;
      gap: 4rem 1.5rem;
      margin-top: 3rem;
    }

    .item--1 {
      grid-column: 1 / span 3;
    }
    .item--2 {
      grid-column: 5 / span 3;
      translate: 0 1.6rem;
    }
    .item--3 {
      grid-column: 9 / span 4;
      translate: 0 -0.8rem;
    }
    .item--4 {
      grid-column: 2 / span 3;
      translate: 0 1rem;
    }
    .item--5 {
      grid-column: 6 / span 3;
      translate: 0 2.6rem;
    }
    .item--6 {
      grid-column: 10 / span 3;
      translate: 0 2rem;
    }

    .cierre {
      grid-template-columns: auto auto;
      align-items: end;
      justify-content: end;
      gap: 3rem;
      margin-top: 6rem;
    }
  }
</style>
